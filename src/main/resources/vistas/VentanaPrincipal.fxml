<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.iesalandalus.programacion.tallermecanico.vista.ventanas.controladores.VentanaPrincipal">
   <children>
      <MenuBar>
        <menus>
          <Menu mnemonicParsing="false" text="File">
            <items>
              <MenuItem mnemonicParsing="false" text="Close" />
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Edit">
            <items>
              <MenuItem mnemonicParsing="false" text="Delete" />
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Help">
            <items>
              <MenuItem mnemonicParsing="false" text="About" />
            </items>
          </Menu>
        </menus>
      </MenuBar>
      <HBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="800.0" prefWidth="1000.0">
         <children>
            <TabPane prefHeight="800.0" prefWidth="1005.0" tabClosingPolicy="UNAVAILABLE">
              <tabs>
                <Tab text="Clientes">
                     <content>
                        <VBox prefHeight="200.0" prefWidth="100.0">
                           <children>
                              <VBox alignment="TOP_CENTER" prefHeight="781.0" prefWidth="1000.0">
                                 <children>
                                    <Label text="Clientes">
                                       <font>
                                          <Font size="36.0" />
                                       </font>
                                       <VBox.margin>
                                          <Insets top="20.0" />
                                       </VBox.margin>
                                    </Label>
                                    <TableView fx:id="tabla_cliente" prefHeight="421.0" prefWidth="960.0">
                                      <columns>
                                        <TableColumn fx:id="co_dni" prefWidth="75.0" text="DNI" />
                                        <TableColumn fx:id="co_nombre" prefWidth="75.0" text="Nombre" />
                                          <TableColumn fx:id="co_telefono" prefWidth="75.0" text="Telefono" />
                                      </columns>
                                       <VBox.margin>
                                          <Insets left="20.0" right="20.0" top="50.0" />
                                       </VBox.margin>
                                    </TableView>
                                    <HBox alignment="TOP_RIGHT" prefHeight="100.0" prefWidth="200.0">
                                       <children>
                                          <Button mnemonicParsing="false" text="Buscar cliente">
                                             <HBox.margin>
                                                <Insets right="5.0" />
                                             </HBox.margin>
                                          </Button>
                                          <Button mnemonicParsing="false" onAction="#insertarCliente" text="Añadir cliente">
                                             <HBox.margin>
                                                <Insets right="5.0" />
                                             </HBox.margin>
                                          </Button>
                                          <Button alignment="TOP_RIGHT" mnemonicParsing="false" text="Borrar cliente">
                                             <HBox.margin>
                                                <Insets right="20.0" />
                                             </HBox.margin>
                                          </Button>
                                       </children>
                                       <VBox.margin>
                                          <Insets bottom="40.0" />
                                       </VBox.margin>
                                    </HBox>
                                 </children>
                              </VBox>
                           </children>
                        </VBox>
                     </content>
                  </Tab>
                <Tab text="Vehiculo">
                     <content>
                        <VBox prefHeight="200.0" prefWidth="100.0">
                           <children>
                              <VBox alignment="TOP_CENTER" prefHeight="873.0" prefWidth="1000.0">
                                 <children>
                                    <Label text="Vehiculos">
                                       <font>
                                          <Font size="36.0" />
                                       </font>
                                       <VBox.margin>
                                          <Insets top="20.0" />
                                       </VBox.margin>
                                    </Label>
                                    <TableView fx:id="tabla_cliente1" prefHeight="421.0" prefWidth="960.0">
                                       <columns>
                                          <TableColumn fx:id="co_dni1" prefWidth="75.0" text="DNI" />
                                          <TableColumn fx:id="co_nombre1" prefWidth="75.0" text="Nombre" />
                                          <TableColumn fx:id="co_telefono1" prefWidth="75.0" text="Telefono" />
