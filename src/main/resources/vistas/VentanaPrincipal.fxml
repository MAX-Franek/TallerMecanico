                                       <VBox.margin>
                                          <Insets left="20.0" right="20.0" top="50.0" />
                                       </VBox.margin>
                                    </TableView>
                                    <HBox alignment="TOP_RIGHT" prefHeight="100.0" prefWidth="200.0">
                                       <children>
                                          <Button mnemonicParsing="false" text="Buscar vehiculo">
                                             <HBox.margin>
                                                <Insets right="5.0" />
                                             </HBox.margin>
                                          </Button>
                                          <Button mnemonicParsing="false" onAction="#insertarVehiculo" text="Añadir vehiculo">
                                             <HBox.margin>
                                                <Insets right="5.0" />
                                             </HBox.margin>
                                          </Button>
                                          <Button alignment="TOP_RIGHT" mnemonicParsing="false" text="Borrar vehiculo">
                                             <HBox.margin>
                                                <Insets right="20.0" />
                                             </HBox.margin>
                                          </Button>
                                       </children>
                                    </HBox>
                                 </children>
                              </VBox>
                           </children>
                        </VBox>
                     </content>
                  </Tab>
                  <Tab text="Revisiones">
                     <content>
                        <VBox prefHeight="200.0" prefWidth="100.0">
                           <children>
                              <VBox alignment="TOP_CENTER" prefHeight="792.0" prefWidth="1000.0">
                                 <children>
                                    <Label text="Revisiones">
                                       <font>
                                          <Font size="36.0" />
                                       </font>
                                       <VBox.margin>
                                          <Insets top="20.0" />
                                       </VBox.margin>
                                    </Label>
                                    <TableView fx:id="tabla_cliente2" prefHeight="421.0" prefWidth="960.0">
                                       <columns>
                                          <TableColumn fx:id="co_dni2" prefWidth="75.0" text="DNI" />
                                          <TableColumn fx:id="co_nombre2" prefWidth="75.0" text="Nombre" />
                                          <TableColumn fx:id="co_telefono2" prefWidth="75.0" text="Telefono" />
                                       </columns>
                                       <VBox.margin>
                                          <Insets left="20.0" right="20.0" top="50.0" />
                                       </VBox.margin>
                                    </TableView>
                                    <HBox alignment="TOP_RIGHT" prefHeight="100.0" prefWidth="200.0">
                                       <children>
                                          <Button mnemonicParsing="false" text="Buscar revision">
                                             <HBox.margin>
                                                <Insets right="5.0" />
                                             </HBox.margin>
                                          </Button>
                                          <Button mnemonicParsing="false" onAction="#leerRevision" text="Añadir revision">
                                             <HBox.margin>
                                                <Insets right="5.0" />
                                             </HBox.margin>
                                          </Button>
                                          <Button alignment="TOP_RIGHT" mnemonicParsing="false" text="Borrar revision">
                                             <HBox.margin>
                                                <Insets right="20.0" />
                                             </HBox.margin>
                                          </Button>
                                       </children>
                                    </HBox>
                                 </children>
                              </VBox>
                           </children>
                        </VBox>
                     </content>
                  </Tab>
              </tabs>
            </TabPane>
         </children>
      </HBox>
   </children>
